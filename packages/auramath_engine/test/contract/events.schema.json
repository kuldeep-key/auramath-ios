{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auramath.net/schemas/events.schema.json",
  "title": "Auramath child event (v0.1)",
  "description": "Envelope plus one payload per event name. Payloads allow no free text from a child (DAT-07): every string is an id or an enum. Server-derived records (scores, reports) are not client events.",
  "type": "object",
  "required": ["event_id", "session_id", "seq", "at", "name", "child_ref", "device_id", "app_version", "payload"],
  "additionalProperties": false,
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "session_id": {"type": "string", "format": "uuid"},
    "seq": {"type": "integer", "minimum": 0},
    "at": {"type": "integer", "minimum": 1500000000000, "description": "Epoch milliseconds"},
    "name": {"enum": ["badge_awarded", "badge_shared", "choice_selected", "connectivity_changed", "easier_chosen", "easier_number_sentence_shown", "help_opened", "hint_shown", "i_know_it_answered", "i_know_it_opened", "idle_prompt_shown", "number_sentence_entered", "object_moved", "object_placed", "placement_answered", "problem_completed", "problem_left", "problem_shown", "prompt_answered", "question_chip_tapped", "question_reopened", "quick_sum_answered", "read_aloud_played", "session_ended", "session_paused", "session_resumed", "session_started", "side_lesson_ended", "side_lesson_started", "step_committed", "step_entered", "undo_used", "value_entered", "word_meaning_opened", "worked_example_shown"]},
    "child_ref": {"type": "string", "pattern": "^ch_[A-Za-z0-9]{8,32}$", "description": "Opaque id, never a name"},
    "device_id": {"type": "string", "pattern": "^dv_[A-Za-z0-9]{8,32}$"},
    "app_version": {"type": "string"},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"name": {"const": "badge_awarded"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/badge_awarded"}}}},
    {"if": {"properties": {"name": {"const": "badge_shared"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/badge_shared"}}}},
    {"if": {"properties": {"name": {"const": "choice_selected"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/choice_selected"}}}},
    {"if": {"properties": {"name": {"const": "connectivity_changed"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/connectivity_changed"}}}},
    {"if": {"properties": {"name": {"const": "easier_chosen"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/easier_chosen"}}}},
    {"if": {"properties": {"name": {"const": "easier_number_sentence_shown"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/easier_number_sentence_shown"}}}},
    {"if": {"properties": {"name": {"const": "help_opened"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/help_opened"}}}},
    {"if": {"properties": {"name": {"const": "hint_shown"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/hint_shown"}}}},
    {"if": {"properties": {"name": {"const": "i_know_it_answered"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/i_know_it_answered"}}}},
    {"if": {"properties": {"name": {"const": "i_know_it_opened"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/i_know_it_opened"}}}},
    {"if": {"properties": {"name": {"const": "idle_prompt_shown"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/idle_prompt_shown"}}}},
    {"if": {"properties": {"name": {"const": "number_sentence_entered"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/number_sentence_entered"}}}},
    {"if": {"properties": {"name": {"const": "object_moved"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/object_moved"}}}},
    {"if": {"properties": {"name": {"const": "object_placed"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/object_placed"}}}},
    {"if": {"properties": {"name": {"const": "placement_answered"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/placement_answered"}}}},
    {"if": {"properties": {"name": {"const": "problem_completed"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/problem_completed"}}}},
    {"if": {"properties": {"name": {"const": "problem_left"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/problem_left"}}}},
    {"if": {"properties": {"name": {"const": "problem_shown"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/problem_shown"}}}},
    {"if": {"properties": {"name": {"const": "prompt_answered"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/prompt_answered"}}}},
    {"if": {"properties": {"name": {"const": "read_aloud_played"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/read_aloud_played"}}}},
    {"if": {"properties": {"name": {"const": "session_ended"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/session_ended"}}}},
    {"if": {"properties": {"name": {"const": "session_paused"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/session_paused"}}}},
    {"if": {"properties": {"name": {"const": "session_resumed"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/session_resumed"}}}},
    {"if": {"properties": {"name": {"const": "session_started"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/session_started"}}}},
    {"if": {"properties": {"name": {"const": "side_lesson_ended"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/side_lesson_ended"}}}},
    {"if": {"properties": {"name": {"const": "side_lesson_started"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/side_lesson_started"}}}},
    {"if": {"properties": {"name": {"const": "step_committed"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/step_committed"}}}},
    {"if": {"properties": {"name": {"const": "step_entered"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/step_entered"}}}},
    {"if": {"properties": {"name": {"const": "undo_used"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/undo_used"}}}},
    {"if": {"properties": {"name": {"const": "value_entered"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/value_entered"}}}},
    {"if": {"properties": {"name": {"const": "word_meaning_opened"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/word_meaning_opened"}}}},
    {"if": {"properties": {"name": {"const": "question_chip_tapped"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/question_chip_tapped"}}}},
    {"if": {"properties": {"name": {"const": "question_reopened"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/question_reopened"}}}},
    {"if": {"properties": {"name": {"const": "quick_sum_answered"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/quick_sum_answered"}}}},
    {"if": {"properties": {"name": {"const": "worked_example_shown"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/worked_example_shown"}}}}
  ],
  "$defs": {
    "session_started": {"type": "object", "required": ["launch_source", "content_versions", "is_demo"], "additionalProperties": false, "properties": {"launch_source": {"enum": ["child_opened", "parent_handover", "reminder", "unknown"]}, "content_versions": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}}, "is_demo": {"type": "boolean"}, "is_test": {"type": "boolean"}}},
    "session_paused": {"type": "object", "required": ["reason"], "additionalProperties": false, "properties": {"reason": {"enum": ["call", "lock", "app_closed", "child"]}}},
    "session_resumed": {"type": "object", "required": [], "additionalProperties": false, "properties": {"after_ms": {"type": "integer", "minimum": 0}}},
    "session_ended": {"type": "object", "required": ["reason"], "additionalProperties": false, "properties": {"reason": {"enum": ["finished", "time_up", "left", "app_closed"]}, "active_ms": {"type": "integer", "minimum": 0}}},
    "problem_shown": {"type": "object", "required": ["problem_id", "template_id", "template_version", "story_id", "relation", "numbers"], "additionalProperties": false, "properties": {"problem_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "template_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "template_version": {"type": "string"}, "story_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "relation": {"enum": ["taller", "shorter"]}, "level": {"type": "string", "pattern": "^L[0-9]+$"}, "variant": {"enum": ["standard", "easier", "worked_example", "check"]}, "numbers": {"type": "object", "required": ["A", "D"], "additionalProperties": false, "properties": {"A": {"type": "integer"}, "D": {"type": "integer"}}}}},
    "step_entered": {"type": "object", "required": ["step_id"], "additionalProperties": false, "properties": {"step_id": {"type": "string", "pattern": "^[a-z_]+$"}}},
    "object_placed": {"type": "object", "required": ["step_id", "object", "target", "committed", "ms_from_step_start"], "additionalProperties": false, "properties": {"step_id": {"type": "string", "pattern": "^[a-z_]+$"}, "object": {"enum": ["bar_a", "bar_b", "difference", "total", "label_a", "label_b"]}, "length_units": {"type": "number", "description": "Grid units, not pixels (legacy DAT-14)"}, "committed": {"type": "boolean"}, "ms_from_step_start": {"type": "integer", "minimum": 0}, "target": {"enum": ["bar_a", "bar_b", "gap", "across_both", "board", "none"], "description": "Where it was dropped"}, "value": {"type": "integer", "minimum": 0, "maximum": 9999, "description": "Number carried by the piece, if any (for example 107)"}, "position": {"type": "object", "required": ["x", "y"], "additionalProperties": false, "properties": {"x": {"type": "number"}, "y": {"type": "number"}}}, "relative_to_bar_a": {"enum": ["longer", "shorter", "equal"], "description": "For bar_b only"}}},
    "object_moved": {"type": "object", "required": ["step_id", "object", "ms_from_step_start"], "additionalProperties": false, "properties": {"step_id": {"type": "string", "pattern": "^[a-z_]+$"}, "object": {"enum": ["bar_a", "bar_b", "difference", "total", "label_a", "label_b"]}, "ms_from_step_start": {"type": "integer", "minimum": 0}}},
    "choice_selected": {"type": "object", "required": ["step_id", "option_id", "ms_from_step_start"], "additionalProperties": false, "properties": {"step_id": {"type": "string", "pattern": "^[a-z_]+$"}, "option_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "ms_from_step_start": {"type": "integer", "minimum": 0}}},
    "value_entered": {"type": "object", "required": ["step_id", "value", "submitted", "ms_from_step_start"], "additionalProperties": false, "properties": {"step_id": {"type": "string", "pattern": "^[a-z_]+$"}, "value": {"type": "integer", "minimum": 0, "maximum": 9999}, "submitted": {"type": "boolean"}, "ms_from_step_start": {"type": "integer", "minimum": 0}}},
    "step_committed": {"type": "object", "required": ["step_id", "correct", "ms_from_step_start"], "additionalProperties": false, "properties": {"step_id": {"type": "string", "pattern": "^[a-z_]+$"}, "correct": {"type": "boolean"}, "error_type": {"type": ["string", "null"], "pattern": "^[a-z_]+$"}, "skill_charged": {"type": ["string", "null"]}, "ms_from_step_start": {"type": "integer", "minimum": 0}}},
    "i_know_it_opened": {"type": "object", "required": ["step_id"], "additionalProperties": false, "properties": {"step_id": {"type": ["string", "null"]}}},
    "help_opened": {"type": "object", "required": ["step_id"], "additionalProperties": false, "properties": {"step_id": {"type": "string", "pattern": "^[a-z_]+$"}, "trigger": {"enum": ["child", "after_wrong", "after_quiet"]}}},
    "hint_shown": {"type": "object", "required": ["step_id", "rung_id", "line_id"], "additionalProperties": false, "properties": {"step_id": {"type": "string", "pattern": "^[a-z_]+$"}, "rung_id": {"type": "string"}, "line_id": {"type": "string"}, "model_used": {"type": "boolean"}}},
    "worked_example_shown": {"type": "object", "required": ["example_story_id"], "additionalProperties": false, "properties": {"example_story_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}}},
    "easier_chosen": {"type": "object", "required": ["from_problem_id"], "additionalProperties": false, "properties": {"from_problem_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "trigger": {"enum": ["child", "no_progress"]}}},
    "word_meaning_opened": {"type": "object", "required": ["word_id"], "additionalProperties": false, "properties": {"word_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}}},
    "idle_prompt_shown": {"type": "object", "required": ["level", "after_ms"], "additionalProperties": false, "properties": {"level": {"enum": ["help_pulse", "glow", "demo", "still_there"]}, "after_ms": {"type": "integer", "minimum": 0}, "step_id": {"type": "string", "pattern": "^[a-z_]+$"}}},
    "side_lesson_started": {"type": "object", "required": ["skill_id", "error_type"], "additionalProperties": false, "properties": {"skill_id": {"type": "string"}, "error_type": {"type": "string"}}},
    "side_lesson_ended": {"type": "object", "required": ["skill_id", "completed"], "additionalProperties": false, "properties": {"skill_id": {"type": "string"}, "completed": {"type": "boolean"}}},
    "problem_left": {"type": "object", "required": ["problem_id"], "additionalProperties": false, "properties": {"problem_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "step_id": {"type": ["string", "null"]}}},
    "problem_completed": {"type": "object", "required": ["problem_id", "outcome", "working_ms", "reading_ms", "wrong_count", "hints_used", "drew_model"], "additionalProperties": false, "properties": {"problem_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "outcome": {"enum": ["solved_alone", "one_wrong", "two_or_more_wrong", "with_hints", "left_wrong", "answer_supplied"]}, "working_ms": {"type": "integer", "minimum": 0}, "reading_ms": {"type": "integer", "minimum": 0}, "wrong_count": {"type": "integer", "minimum": 0}, "hints_used": {"type": "integer", "minimum": 0}, "drew_model": {"type": "boolean"}, "via_i_know_it": {"type": "boolean"}}, "description": "Client report. The server re-derives outcome from the log (authoritative), so it can be replayed if the scoring rule changes (D-05)."},
    "badge_awarded": {"type": "object", "required": ["badge_id"], "additionalProperties": false, "properties": {"badge_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}}},
    "read_aloud_played": {"type": "object", "required": ["target"], "additionalProperties": false, "properties": {"target": {"enum": ["question", "hint", "word"]}}},
    "connectivity_changed": {"type": "object", "required": ["online"], "additionalProperties": false, "properties": {"online": {"type": "boolean"}}},
    "placement_answered": {"type": "object", "required": ["item_id", "value", "correct", "ms_from_item_start"], "additionalProperties": false, "properties": {"item_id": {"type": "string", "pattern": "^[a-z0-9._-]+$"}, "value": {"type": "integer", "minimum": 0, "maximum": 9999}, "correct": {"type": "boolean"}, "ms_from_item_start": {"type": "integer", "minimum": 0}}},
    "i_know_it_answered": {"type": "object", "required": ["field", "value", "correct", "ms_from_problem_start"], "additionalProperties": false, "properties": {"field": {"enum": ["unknown", "total"]}, "value": {"type": "integer", "minimum": 0, "maximum": 9999}, "correct": {"type": "boolean"}, "error_type": {"type": ["string", "null"], "pattern": "^[a-z_]+$"}, "stage": {"enum": ["total", "unknown", "total_after_unknown"]}, "route": {"type": ["string", "null"], "pattern": "^[a-z_]+$"}, "ms_from_problem_start": {"type": "integer", "minimum": 0}}},
    "number_sentence_entered": {"type": "object", "required": ["form", "numbers", "correct", "ms_from_step_start"], "additionalProperties": false, "properties": {"form": {"enum": ["A-D=box", "D+box=A", "box+D=A", "A-box=D", "A+D=box", "D+A=box", "box-D=A", "box-A=D", "other"]}, "numbers": {"type": "array", "items": {"type": "integer"}, "maxItems": 3}, "correct": {"type": "boolean"}, "ms_from_step_start": {"type": "integer", "minimum": 0}}},
    "prompt_answered": {"type": "object", "required": ["prompt", "choice"], "additionalProperties": false, "properties": {"prompt": {"enum": ["still_there", "carry_on", "choose_today", "sound_on", "too_hard", "paused", "time_up", "offline"]}, "choice": {"enum": ["help_me", "easier_one", "still_thinking", "keep_going", "stop_for_today", "carry_on", "something_new", "finish_this_one", "call_it_a_day", "sound_on", "read_myself", "try_again", "keep_drawing", "story_problem", "quick_sums", "taking_away", "leave", "dismissed"]}}},
    "easier_number_sentence_shown": {"type": "object", "required": ["step_id"], "additionalProperties": false, "properties": {"step_id": {"type": "string", "pattern": "^[a-z_]+$"}}},
    "undo_used": {"type": "object", "required": ["step_id", "object"], "additionalProperties": false, "properties": {"step_id": {"type": "string", "pattern": "^[a-z_]+$"}, "object": {"enum": ["bar_a", "bar_b", "difference", "total", "label_a", "label_b"]}}},
    "badge_shared": {"type": "object", "required": ["badge_id", "shared"], "additionalProperties": false, "properties": {"badge_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "shared": {"type": "boolean"}}},
    "question_chip_tapped": {"type": "object", "required": ["chip_id", "step_id"], "additionalProperties": false, "description": "TUT-13: the child tapped a tap-to-ask question button. No free text.", "properties": {"chip_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "step_id": {"type": "string", "pattern": "^[a-z_]+$"}, "line_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}}},
    "question_reopened": {"type": "object", "required": ["step_id"], "additionalProperties": false, "properties": {"step_id": {"type": "string", "pattern": "^[a-z_]+$"}}},
    "quick_sum_answered": {"type": "object", "required": ["item_id", "level", "value", "correct", "ms_from_item_start"], "additionalProperties": false, "description": "LES-16: one Quick sums answer, typed on the keypad; also the practice sums in a side lesson (TUT-08), with context side_lesson.", "properties": {"context": {"enum": ["quick_sums", "side_lesson"]}, "item_id": {"type": "string", "pattern": "^[a-z0-9._-]+$"}, "level": {"type": "string", "pattern": "^A[0-9]+$"}, "value": {"type": "integer", "minimum": 0, "maximum": 9999}, "correct": {"type": "boolean"}, "attempt": {"type": "integer", "minimum": 1, "maximum": 2}, "ms_from_item_start": {"type": "integer", "minimum": 0}}}
  }
}
